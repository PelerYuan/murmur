MURMUR_PORT=8000

# Speech-to-text service (the murmur `asr` container, or any OpenAI-compatible STT; switch mode in Settings)
MURMUR_ASR_URL=http://asr:8100
MURMUR_ASR_API_KEY=

# Any OpenAI-compatible chat endpoint (these are only first-run defaults; edit later in Settings → LLM)
MURMUR_LLM_BASE_URL=https://api.openai.com/v1
MURMUR_LLM_API_KEY=
MURMUR_LLM_MODEL=gpt-4o-mini

# Encrypts API keys stored in the database. Leave empty to auto-generate and keep it in the data volume.
MURMUR_SECRET_KEY=

# Recorder (create it under Recorders in the web UI, copy the token here)
MURMUR_CORE_URL=http://core:8000
MURMUR_TOKEN=
